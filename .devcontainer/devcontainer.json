{
  "name": "Debian Slim + Conda + ML/LLM",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "WORKSPACE_FOLDER": "${workspaceFolder}"
    }
  },
  "remoteUser": "opoudel",
  "postCreateCommand": "git config --global --add safe.directory ${workspaceFolder} && WORKSPACE_FOLDER=${workspaceFolder} sh ${workspaceFolder}/.devcontainer/setup_conda_env.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}